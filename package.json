{
  "name": "anyx",
  "version": "0.1.0",
  "private": true,
  "description": "AnyX — universal x402 multi-token payment adapter. Pay with any token, settle on x402.",
  "license": "Apache-2.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup": "bash scripts/setup.sh",
    "orchestrate": "bun run orchestrator/cli.ts",
    "config:check": "bun run --cwd packages/config src/cli.ts check",
    "config:missing": "bun run --cwd packages/config src/cli.ts missing",
    "config:list": "bun run --cwd packages/config src/cli.ts list"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.0"
}
