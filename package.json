{
  "name": "anyx",
  "version": "0.1.0",
  "private": true,
  "description": "AnyX \u2014 Universal x402 Multi-Token Payment Adapter",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  }
}
