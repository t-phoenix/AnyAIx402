{
  "name": "anyaix402",
  "version": "0.1.0",
  "private": true,
  "description": "AnyX — pay any x402 API with any token. Settle in USDC on Base.",
  "type": "module",
  "workspaces": ["packages/*", "packages/integrations/*", "apps/*", "agents"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev": "npm run dev:api",
    "agents:run": "tsx agents/orchestrator/cli.ts",
    "check-config": "tsx scripts/check-config.ts",
    "setup": "bash scripts/setup.sh",
    "db:generate": "echo 'Drizzle generate requires DATABASE_URL; schema lives in packages/db'",
    "db:migrate": "echo 'No-op until DATABASE_URL is set'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "turbo": "^2.3.3"
  }
}
