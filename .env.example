# AnyX / AnyAIx402 — Environment Template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
#
# Human checklist: docs/MULTI_AGENT_PLAN.md §5
# Structured map: config/secrets.example.yaml

# ─── Database & cache (Phase 0) ───────────────────────────────────────────────
DATABASE_URL=postgresql://anyx:anyx@localhost:5432/anyx
REDIS_URL=redis://localhost:6379

# ─── API server ───────────────────────────────────────────────────────────────
PORT=3000
# Admin / internal routes
API_SECRET=replace-with-long-random-string
# Public API base (SDK default override for local)
ANYX_API_BASE_URL=http://localhost:3000

# ─── Fee configuration ────────────────────────────────────────────────────────
# 20 = 0.20% default swap spread
FEE_BPS=20
MIN_FEE_USDC=0.001

# ─── EVM RPCs ─────────────────────────────────────────────────────────────────
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_ETHEREUM=https://eth.llamarpc.com
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com

# ─── Hot signer (Phase 1 DEV ONLY — use MPC/Turnkey/Lit in production) ────────
# Signs EIP-3009 authorizations after USDC is available
PRIVATE_KEY=0xYOUR_DEV_PRIVATE_KEY_NEVER_COMMIT_REAL

# ─── DEX aggregators (Phase 1) ────────────────────────────────────────────────
ONEINCH_API_KEY=
ZEROX_API_KEY=

# ─── x402 facilitators ────────────────────────────────────────────────────────
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_FALLBACK_URL=https://x402.halowerk.com/facilitator

# ─── Circle CCTP (Phase 3) ────────────────────────────────────────────────────
CCTP_ATTESTER_URL=https://iris-api.circle.com

# ─── Contract addresses (fill after deploy) ───────────────────────────────────
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ANYX_ROUTER=
FEE_COLLECTOR=
RESERVE_POOL=
BASESCAN_API_KEY=

# ─── Stripe billing (Phase 6) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ─── Lightning / LND (Phase 4) ────────────────────────────────────────────────
LND_TLS_CERT_PATH=
LND_MACAROON_PATH=
# Or Lightning Node Connect credentials if used instead of local LND
# LNC_CONNECTION_STRING=

# ─── Deploy / publish (CI secrets — set in GitHub, not required locally) ──────
# FLY_API_TOKEN=
# NPM_TOKEN=

# ─── Optional: Coinbase CDP / AgentKit integrations ───────────────────────────
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# ─── Optional: AnyX API key when calling hosted API as a client ───────────────
ANYX_API_KEY=

# ─── Optional: wallet / widget (browser pay-with-ETH play) ────────────────────
# WALLETCONNECT_PROJECT_ID=
# PHANTOM_ / other wallet adapter keys as needed
