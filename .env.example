# =============================================================================
# AnyX / AnyAIx402 — environment template
# Copy this file to .env.local and fill in only what you need.
# Never commit .env.local. The setup wizard at /setup and `npm run check-config`
# will tell you in plain language what is still missing.
# =============================================================================

# --- App ---
# Port the API listens on (default 3000).
PORT=3000
# Set to "development" locally. Use "production" on Fly.io / Docker.
NODE_ENV=development
# When "true", /v1/pay returns a simulated receipt (safe default for local/tests).
# Flip to "false" only when a funded USDC signer is configured.
ANYX_STUB_PAYMENTS=true
# Public API origin used in receipts and the SDK default.
ANYX_PUBLIC_URL=http://localhost:3000

# --- Database (optional until you persist quotes/payments) ---
# Local default matches docker-compose.yml. Leave unset to use in-memory storage.
# DATABASE_URL=postgresql://anyx:anyx@localhost:5432/anyx

# --- Redis (optional: quote cache + rate limits) ---
# REDIS_URL=redis://localhost:6379

# --- Blockchain RPCs ---
# Base is required for live quotes/payments. Public endpoints work for demos;
# a dedicated RPC (Alchemy, Infura, QuickNode) is better for production.
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# Ethereum / Solana are Phase 2+. Safe to leave blank for v0.
RPC_URL_ETHEREUM=https://eth.llamarpc.com
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com

# --- Hot signer (REQUIRED for live /v1/pay, NOT for quote-only) ---
# This key signs EIP-3009 USDC authorizations. In v0 it is a local key whose
# wallet must hold USDC on Base (the "float"). In production use Turnkey/Lit MPC.
# Use a throwaway testnet/mainnet wallet. Never a funded personal wallet.
# PRIVATE_KEY=0xYOUR_64_HEX_CHARS_WITHOUT_QUOTES

# --- DEX aggregators (at least one key for LIVE quotes) ---
# Without these, AnyX returns clearly labeled stub quotes so you can develop.
# 1inch: https://portal.1inch.dev/
ONEINCH_API_KEY=
# 0x: https://dashboard.0x.org/
ZEROX_API_KEY=

# --- x402 facilitator ---
# Primary: Coinbase CDP x402. Fallback: self-hosted (qntx / open facilitator).
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_FALLBACK_URL=https://x402.halowerk.com/facilitator
# Optional Coinbase CDP credentials if you use CDP-hosted wallets / AgentKit.
# CDP_API_KEY_NAME=
# CDP_API_KEY_PRIVATE_KEY=

# --- Circle CCTP (Phase 2 cross-chain USDC; not needed for Base-only v0) ---
CCTP_ATTESTER_URL=https://iris-api.circle.com

# --- Fee configuration ---
# Default spread in basis points (20 = 0.20%). Per-token overrides live in code.
FEE_BPS=20
MIN_FEE_USDC=0.001

# --- Known contract addresses (Base mainnet) ---
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Set after you deploy AnyXRouter / FeeCollector (Phase 2).
ANYX_ROUTER=
FEE_COLLECTOR=

# --- Admin / API keys ---
# Protects /v1/keys and other admin routes. Generate a long random string.
API_SECRET=

# --- Stripe (Phase 6 Pro plan, $49/mo) — leave blank until billing ships ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=

# --- Prices (optional; otherwise stub/cached prices) ---
# COINGECKO_API_KEY=

# --- Multi-agent system (optional LLM assist) ---
# Orchestrator always runs deterministic tools. These keys only unlock
# natural-language planning. Either provider is enough.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Lightning (Phase 3) — do not fill until LN is in scope ---
# LND_TLS_CERT_PATH=
# LND_MACAROON_PATH=
# LND_GRPC_HOST=localhost:10009

# --- Webhooks (optional: notify your app when a payment settles) ---
# PAYMENT_WEBHOOK_URL=https://example.com/webhooks/anyx
# PAYMENT_WEBHOOK_SECRET=

# --- Deploy (CI only; set as GitHub Actions secrets, not in this file) ---
# FLY_API_TOKEN=
# NPM_TOKEN=
# BASESCAN_API_KEY=
