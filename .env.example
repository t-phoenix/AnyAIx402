# AnyAIx402 (AnyX) — Environment Configuration
# Copy this file to .env.local and fill in what you have.
# See docs/CONFIGURATION.md for what each variable does and how to obtain it.
# Anything left blank degrades gracefully — mocked in dev/tests, CONFIG_MISSING error in prod.

# ── Tier 0: Local infra (works out of the box via docker-compose up) ──────────
DATABASE_URL=postgresql://anyx:anyx@localhost:5432/anyx
REDIS_URL=redis://localhost:6379

# ── Tier 1: Core swap/payment engine (Phase 1) ─────────────────────────────────
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_ETHEREUM=https://eth.llamarpc.com
ONEINCH_API_KEY=
ZEROX_API_KEY=
PRIVATE_KEY=
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_FALLBACK_URL=

# ── Fee configuration (fully automatic, safe defaults) ─────────────────────────
FEE_BPS=20
MIN_FEE_USDC=0.001

# ── API server ──────────────────────────────────────────────────────────────────
PORT=3000
API_SECRET=
CORS_ALLOWED_ORIGINS=*

# ── Contract addresses (Base mainnet — public, no action needed) ──────────────
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ANYX_ROUTER=
FEE_COLLECTOR=

# ── Tier 2: Smart contract deployment (Phase 2) ────────────────────────────────
BASESCAN_API_KEY=
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# ── Tier 3: Cross-chain (Phase 3) ───────────────────────────────────────────────
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com
CCTP_ATTESTER_URL=https://iris-api.circle.com

# ── Tier 4: Lightning / BTC (Phase 4) ───────────────────────────────────────────
LND_TLS_CERT_PATH=
LND_MACAROON_PATH=

# ── Tier 5: Billing (Phase 6) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Tier 6: Release/deploy ───────────────────────────────────────────────────────
FLY_API_TOKEN=
NPM_TOKEN=
