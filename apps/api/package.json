{
  "name": "@anyx/api",
  "version": "0.1.0",
  "private": true,
  "description": "AnyX REST API server (Hono + Bun) — quotes, payments, receipts, tokens, Lightning stub.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anyx/core": "workspace:*",
    "@anyx/db": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
