{
  "name": "@anyx/core",
  "version": "0.1.0",
  "private": true,
  "description": "AnyX core engine: token registry, DEX quote aggregation, x402 client, EIP-3009 signing, facilitator client",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "viem": "^2.55.19",
    "zod": "^3.25.76"
  }
}
